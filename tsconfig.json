{
  "compilerOptions": {
    "target": "ES2018",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "pretty": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noImplicitAny": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "node_modules/@types"
  ]
}
